# TECHNOVA Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control

# ============================================
# Application Configuration
# ============================================
APP_NAME=TECHNOVA
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ============================================
# PostgreSQL (local)
# ============================================
DATABASE_URL=postgresql+asyncpg://technova:technova@localhost:5432/technova
POSTGRES_USER=technova
POSTGRES_PASSWORD=technova
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=technova
DATABASE_ECHO=false

# ============================================
# MongoDB (local)
# ============================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=technova

# ============================================
# Security Configuration
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# External API Configuration
# ============================================
GMAIL_API_KEY=your_gmail_api_key
MICROSOFT_GRAPH_API_KEY=your_microsoft_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=your_openai_api_key

# ============================================
# API Integration (unified inbox email sync)
# Leave blank for mock mode — the connect/sync flow works without these.
# Set them to activate real OAuth.
# ============================================
PUBLIC_BASE_URL=http://localhost:8000
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback

# ============================================
# AI (Groq) — optional; without a key every AI feature
# falls back to heuristics/templates
# ============================================
GROQ_API_KEY=
# Requirement understanding, Tamil/Tanglish, translation, comparisons
GROQ_MODEL=openai/gpt-oss-120b
# High-volume seller reply drafts
GROQ_MODEL_FAST=openai/gpt-oss-20b

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
