# TECHNOVA Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control

# ============================================
# Application Configuration
# ============================================
APP_NAME=TECHNOVA
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ============================================
# PostgreSQL / Supabase Configuration
# ============================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/technova
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=technova
DATABASE_ECHO=false

# ============================================
# MongoDB / Atlas Configuration
# ============================================
# Format: mongodb+srv://username:password@cluster.mongodb.net
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_USERNAME=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=technova

# ============================================
# Redis Configuration
# ============================================
# For local development:
# REDIS_URL=redis://localhost:6379/0
# For cloud Redis (with authentication):
# REDIS_URL=redis://username:password@host:port/db
REDIS_URL=redis://default:password@redis-host:16666
REDIS_HOST=redis-host
REDIS_PORT=16666
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_public_key
SUPABASE_SECRET=your_supabase_secret_key

# ============================================
# Security Configuration
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# External API Configuration
# ============================================
GMAIL_API_KEY=your_gmail_api_key
MICROSOFT_GRAPH_API_KEY=your_microsoft_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=your_openai_api_key

# ============================================
# API Integration (unified inbox email sync)
# Leave blank for mock mode — the connect/sync flow works without these.
# Set them to activate real OAuth.
# ============================================
PUBLIC_BASE_URL=http://localhost:8000
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ============================================
# File Storage Configuration
# ============================================
STORAGE_BUCKET=technova-files
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
